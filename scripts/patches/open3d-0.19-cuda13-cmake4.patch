+    if(NOT EXISTS "${SCANLAN_STDGPU_CUDA13_PATCH}")
+        message(FATAL_ERROR "CUDA 13 stdgpu compatibility patch not found: ${SCANLAN_STDGPU_CUDA13_PATCH}")
